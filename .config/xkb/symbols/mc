default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(basic)"

    name[Group1] = "Minecraft";

    key <AD01> { [ u, U ] }; // q > u
    key <AD02> { [ n, N ] }; // w > n
    key <AD03> { [ e, E ] }; // e > e
    key <AD04> { [ y, Y ] }; // r > y

    key <AC01> { [ i, I ] }; // a > i, I
    key <AC02> { [ U01B0, U01AF ] }; // s > ư, Ư
    key <AC03> { [ U00E1, U00C1 ] }; // d > á, Á
    key <AC04> { [ U00F4, U00D4] }; // f > ô, Ô

    key <AB01> { [ U1EAF, U1EAE ] }; // z > ắ, Ắ
    key <AB02> { [ U00E0, U00C0 ] }; // x > à, À

    key <AB03> { [ c, C ] }; // c >
    key <AB04> { [ U00EC, U00CC ] }; // v > ì, Ì
};
