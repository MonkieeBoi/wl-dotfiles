default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(basic)"

    name[Group1] = "Minecraft";
    key <AE03> { [ s, asterisk ] }; // 3 > 8
    key <AE01> { [ colon, colon ] }; // 1 > 1, :

    key <LALT> { [ v, V ] };

    key <AD01> { [ u    , U1EBE ] }; // q > u, Ế
    key <AD02> { [ n    , N     ] }; // w > n
    key <AD03> { [ e    , U00CA ] }; // e > e, Ê
    key <AD04> { [ y    , T     ] }; // r > m, T

    key <AC01> { [ i    , I     ] }; // a > i, I
    key <AC02> { [ U01B0, O     ] }; // s > ư, O
    key <AC03> { [ U00E1, U00C1 ] }; // d > á, Á
    key <AC04> { [ U00F4, U0168 ] }; // f > ô, Ũ

    key <AB01> { [ U00E0, U1ECE ] }; // z > ắ, Ỏ
    key <AB02> { [ m    , X     ] }; // x > à, X
    key <AB03> { [ c    , U00D9 ] }; // c > c, Ù
    key <AB04> { [ U00EC, U1EBA ] }; // v > ì, Ẻ
};
