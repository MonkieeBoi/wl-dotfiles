{
    "historyFile": "clipboard_history.json",
    "maxHistory": 100,
    "themeFile": "nord.json",
    "tempDir": "tmp_files",
    "enableMouse": false,
    "keyBindings": {
        "up": "k",
        "down": "j",
        "nextPage": "l",
        "prevPage": "h",
        "quit": "q"
    },
    "imageDisplay": {
        "type": "sixel",
        "scaleX": 15,
        "scaleY": 11,
        "heightCut": 2
    }
}
